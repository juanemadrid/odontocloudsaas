rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══════════════════════════════════════════════════════════
    // CONFIGURACIÓN - API Keys y configuraciones globales
    // ═══════════════════════════════════════════════════════════
    match /configuracion/{inquilino} {
      // Lectura: cualquier usuario autenticado de ese inquilino
      allow read: if request.auth != null 
                  && request.auth.token.inquilino == inquilino;
      
      // Escritura: SOLO administradores del inquilino
      allow write: if request.auth != null 
                   && request.auth.token.inquilino == inquilino
                   && request.auth.token.role == 'admin';
    }
    
    // ═══════════════════════════════════════════════════════════
    // PACIENTES
    // ═══════════════════════════════════════════════════════════
    match /pacientes/{pacienteId} {
      allow read, write: if request.auth != null 
                         && request.auth.token.inquilino == resource.data.inquilino;
    }
    
    // ═══════════════════════════════════════════════════════════
    // AGENDA (Citas)
    // ═══════════════════════════════════════════════════════════
    match /agenda/{citaId} {
      allow read, write: if request.auth != null 
                         && request.auth.token.inquilino == resource.data.inquilino;
    }
    
    // ═══════════════════════════════════════════════════════════
    // FACTURAS
    // ═══════════════════════════════════════════════════════════
    match /facturas/{facturaId} {
      allow read, write: if request.auth != null 
                         && request.auth.token.inquilino == resource.data.inquilino;
    }
    
    // ═══════════════════════════════════════════════════════════
    // PLANES DE TRATAMIENTO
    // ═══════════════════════════════════════════════════════════
    match /treatment_plans/{planId} {
      allow read, write: if request.auth != null 
                         && request.auth.token.inquilino == resource.data.inquilino;
    }
    
    // ═══════════════════════════════════════════════════════════
    // INVENTARIO
    // ═══════════════════════════════════════════════════════════
    match /inventario/{itemId} {
      allow read, write: if request.auth != null 
                         && request.auth.token.inquilino == resource.data.inquilino;
    }
    
    // ═══════════════════════════════════════════════════════════
    // USUARIOS
    // ═══════════════════════════════════════════════════════════
    match /users/{userId} {
      // Cualquiera puede leer su propio perfil
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Solo el propio usuario o admin pueden escribir
      allow write: if request.auth != null 
                   && (request.auth.uid == userId 
                       || request.auth.token.role == 'admin');
    }
    
    // ═══════════════════════════════════════════════════════════
    // AUTOMATIZACIONES / EVENTOS
    // ═══════════════════════════════════════════════════════════
    match /automation_events/{eventId} {
      allow read, write: if request.auth != null 
                         && request.auth.token.inquilino == resource.data.inquilino;
    }
    
    // ═══════════════════════════════════════════════════════════
    // DENEGAR TODO LO DEMÁS POR DEFECTO
    // ═══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
