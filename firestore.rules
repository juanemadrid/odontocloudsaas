rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function hasUserProfile() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userTenant() {
      return request.auth.token.inquilino != null
        ? request.auth.token.inquilino
        : userProfile().data.inquilino;
    }

    function userRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : userProfile().data.rol;
    }

    function isSuperAdmin() {
      return signedIn()
        && (
          request.auth.token.role == 'superadmin'
          || (hasUserProfile() && userRole() == 'superadmin')
        );
    }

    function isTenantMember(tenantId) {
      return signedIn()
        && tenantId is string
        && (
          request.auth.token.inquilino == tenantId
          || (hasUserProfile() && userTenant() == tenantId)
          || isSuperAdmin()
        );
    }

    function isTenantDocument(data) {
      return (data.inquilino is string && isTenantMember(data.inquilino))
        || (data.tenantId is string && isTenantMember(data.tenantId));
    }

    function keepsTenant(oldData, newData) {
      return isTenantDocument(oldData)
        && isTenantDocument(newData)
        && (
          oldData.inquilino == newData.inquilino
          || oldData.tenantId == newData.tenantId
          || isSuperAdmin()
        );
    }

    function isTenantScopedCollection(collectionId) {
      return collectionId in [
        'agenda',
        'automation_events',
        'bancos',
        'catalogo_procedimientos',
        'citas',
        'consecutivos',
        'consultorios',
        'entidades',
        'eps_catalogo',
        'especialidades',
        'evoluciones',
        'facturas',
        'inventario',
        'liquidaciones',
        'listas_precios',
        'notas_credito',
        'notas_debito',
        'odontogramas',
        'pacientes',
        'pagos',
        'planes',
        'precios',
        'productos',
        'profesionales',
        'recibos_caja',
        'rips_archivos',
        'saldos_favor',
        'sucursales',
        'treatment_plans',
        'usuarios'
      ];
    }

    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId)
        || resource.data.public == true
        || resource.data.websitePublic == true;
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin() || isTenantMember(tenantId);

      match /{document=**} {
        allow read, write: if isTenantMember(tenantId);
      }
    }

    match /website_config/{tenantId} {
      allow read: if true;
      allow write: if isTenantMember(tenantId);
    }

    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /payment_methods/{methodId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin()
        || (signedIn() && isTenantDocument(resource.data));
    }

    match /usuarios/{userId} {
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isSuperAdmin()
          || isTenantDocument(resource.data)
          || resource.data.email == request.auth.token.email
        );
      allow create: if signedIn()
        && (
          isSuperAdmin()
          || request.auth.uid == userId
          || isTenantDocument(request.resource.data)
        );
      allow update: if signedIn()
        && (
          isSuperAdmin()
          || request.auth.uid == userId
          || keepsTenant(resource.data, request.resource.data)
        );
      allow delete: if isSuperAdmin() || isTenantDocument(resource.data);
    }

    match /{collectionId}/{docId} {
      allow read: if isTenantScopedCollection(collectionId)
        && isTenantDocument(resource.data);
      allow create: if isTenantScopedCollection(collectionId)
        && isTenantDocument(request.resource.data);
      allow update: if isTenantScopedCollection(collectionId)
        && keepsTenant(resource.data, request.resource.data);
      allow delete: if isTenantScopedCollection(collectionId)
        && isTenantDocument(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
