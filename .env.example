# ================================
# ODONTOCLOUD - Variables de Entorno
# ================================

# ================================
# ================================

# ================================
# 1.1 SEGURIDAD DE RUNTIME
# ================================
# Mantener estos valores apagados en produccion salvo decision explicita.
# Los bypass de desarrollo solo funcionan en npm run dev, no en build.
VITE_ENABLE_DEV_BYPASS=false
VITE_ENABLE_OFFLINE_SESSION=false

# ================================
# 2. INTEGRACIONES PRIVADAS: EDGE FUNCTIONS
# ================================
# NUNCA agregue tokens, contrasenas o API keys con prefijo VITE_.
# Configure los secretos en Supabase Edge Functions, no en este archivo:
#
# supabase secrets set GEMINI_API_KEY=... WA_TOKEN=... WA_PHONE_ID=...
# supabase secrets set WA_TEMPLATE_CONFIRMACION=cita_confirmacion
# supabase secrets set WA_TEMPLATE_RECORDATORIO=cita_recordatorio
# supabase secrets set WA_TEMPLATE_LANGUAGE=es_CO WA_GRAPH_API_VERSION=<version-soportada>
#
# Factus y las claves Gemini por clinica se configuran desde la aplicacion y
# se almacenan en tenant_secrets, una tabla privada accesible solo al backend.

# ================================
# 4. EMAILJS (OPCIONAL)
# ================================
# Para envío de correos electrónicos
# Obtener en: https://www.emailjs.com/
# Plan gratuito: 200 emails/mes

# Estas keys están hardcodeadas en src/services/emailService.js
# Si quieres usar tus propias keys, descoméntalas aquí y actualiza el código:

# VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
# VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxx

# ================================
# 5. N8N WEBHOOKS (NO NECESARIO)
# ================================
# Usuario confirmó que NO usará n8n para automatizaciones
# Mantener comentado o eliminar

# VITE_N8N_WEBHOOK_URL=https://tu-instancia-n8n.com/webhook/...

# ================================
# 6. FACTURACIÓN DIAN (NO IMPLEMENTADO)
# ================================
# ⚠️ ADVERTENCIA: Facturación electrónica NO está implementada
# El sistema actual usa mock/simulación sin validez legal

# Para implementar, contratar proveedor autorizado:
# - FacturaTech: https://factura.tech/
# - Alexa: https://alexa.com.co/
# - Siigo: https://www.siigo.com/
# - Dataico: https://dataico.com/

# Variables futuras necesarias (cuando se implemente):
# VITE_DIAN_PROVIDER_URL=https://api-proveedor.com
# VITE_DIAN_API_KEY=tu_api_key_proveedor
# VITE_DIAN_COMPANY_NIT=900123456
# VITE_DIAN_SOFTWARE_ID=xxx-xxx-xxx-xxx
# VITE_DIAN_SOFTWARE_PIN=12345

# ================================
# 7. OTROS (FUTUROS)
# ================================

# Pasarela de pagos (si se implementa)
# VITE_PAYMENT_GATEWAY=mercadopago
# VITE_MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VITE_MP_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Analytics
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Error tracking (Sentry)
# VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# ================================
# NOTAS IMPORTANTES
# ================================

# 1. NUNCA subir este archivo con valores reales a Git
# 2. Crear .env.local con tus valores reales
# 3. .env.local está en .gitignore por seguridad
# 4. Variables con prefijo VITE_ se exponen al cliente
# 5. NO incluir secrets sensibles del backend aquí

# Para desarrollo:
#   cp .env.example .env.local
#   # Editar .env.local con tus valores

# Para producción:
