# =============================================================================
# ODONTOCLOUD — PLANTILLA SEGURA DE CONFIGURACIÓN IHCE (MINSALUD COLOMBIA)
# Archivo de ejemplo: .env.ihce.example
# =============================================================================
# INSTRUCCIONES DE SEGURIDAD:
# 1. Copie este archivo como '.env.ihce.local' en su máquina local.
# 2. Complete las variables con los valores oficiales de PREPRODUCCIÓN asignados
#    por el Ministerio de Salud en el portal de Administración de Llaves.
# 3. NUNCA suba '.env.ihce.local' a Git ni comparta ClientSecret o APIMsubkey.
# 4. Mantenga las credenciales de PRODUCCIÓN completamente fuera de este archivo.
# =============================================================================

# AMBIENTE OPERATIVO (Valores permitidos: SANDBOX_MOCK, PREPRODUCCION)
# PRODUCCION está estrictamente bloqueado en código hasta certificación oficial.
IHCE_ENVIRONMENT=PREPRODUCCION

# Salvaguarda de red: true solo para ejecutar el runner de pruebas autorizado
IHCE_LIVE_ENABLED=false

# =============================================================================
# DATOS DEL PRESTADOR ASIGNADO (REPS OFICIAL)
# =============================================================================
# Prestador: Guillermo José Rodríguez Mercado
# Tipo: Profesional independiente
IHCE_PRESTADOR_NOMBRE="Guillermo José Rodríguez Mercado"
IHCE_PRESTADOR_TIPO="PROFESIONAL_INDEPENDIENTE"

# Código de prestador: exactamente 10 dígitos asignados en REPS
IHCE_PRESTADOR_REPS="7000101658"

# Código de sede: exactamente 2 dígitos (normalmente '01')
IHCE_PRESTADOR_SEDE="01"

# Servicio habilitado según registro REPS: 334 (Odontología General)
IHCE_PRESTADOR_SERVICIO="334"

# Documento de identidad y registro RETHUS del profesional
IHCE_PRESTADOR_TIPO_DOC="CC"
IHCE_PRESTADOR_DOCUMENTO=""
IHCE_PRESTADOR_RETHUS=""

# =============================================================================
# CREDENCIALES OAUTH2 / APIM MINSALUD (PREPRODUCCIÓN / SANDBOX)
# Obtener del portal oficial de Administración de Llaves
# =============================================================================
# Client ID asignado por MinSalud
IHCE_CLIENT_ID=""

# Client Secret asignado por MinSalud (Custodiar bajo máxima reserva)
IHCE_CLIENT_SECRET=""

# Tenant ID de la pasarela Azure / Entra ID del Ministerio
IHCE_TENANT_ID=""

# Scope autorizado en el portal (ej. api://.../.default o scope específico)
IHCE_SCOPE=""

# Clave de suscripción Azure API Management (Ocp-Apim-Subscription-Key)
IHCE_APIM_SUBKEY=""

# EndPoint base oficial de preproducción del Ministerio de Salud
# (ej. https://vulcano.ihcecol.gov.co/fhir/r4 o la URL indicada en el portal)
IHCE_ENDPOINT=""

# URL directa de token (opcional si difiere de https://login.microsoftonline.com/{TenantID}/oauth2/v2.0/token)
IHCE_TOKEN_ENDPOINT=""

# =============================================================================
# SEGURIDAD CRIPTOGRÁFICA EN REPOSO (LADO SERVIDOR)
# Clave maestra para cifrado simétrico AES-256-GCM (32 bytes en Base64)
# =============================================================================
IHCE_MASTER_ENCRYPTION_KEY=""
